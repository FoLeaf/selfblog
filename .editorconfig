# EditorConfig helps keep Markdown, YAML, HTML, CSS, JavaScript, and Hugo
# template files consistent across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml,json,js,ts,scss,css,html,html.tmpl,go,ps1}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,webp,ico,svg}]
insert_final_newline = unset
